# Copy to .env for local development only. Never commit .env.
# In production, non-secret keys go in the ConfigMap and secrets in the secret store.
# Every key is declared and validated in app/config.py (CLAUDE.md §8).

# ---------- Non-secret (ConfigMap) ----------
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
META_GRAPH_API_VERSION=v23.0

BUSINESS_TIMEZONE=Asia/Riyadh
QUIET_HOURS=22:00-09:00      # local time; reminders/follow-ups shift to the end of it
DEFAULT_LANGUAGE=ar          # used when the customer's language is unclear
TONE=friendly
DIALECT=gulf                 # gulf | saudi | msa
ASSISTANT_NAME=Sara

# Try it on the demo clinic: ./examples/demo-clinic/{business.yaml,faqs.yaml,style_ar.md}
BUSINESS_CONFIG_PATH=./knowledge/business.yaml
FAQ_PATH=./knowledge/faqs.yaml
STYLE_GUIDE_PATH=./knowledge/style_ar.md
KB_RETRIEVAL_ENABLED=false   # not built yet; the app warns at startup when the KB is > ~15k tokens

# Built: internal (bookings in our Postgres) and google_calendar. Build the client's
# adapter for the others (CLAUDE.md §6); the app refuses to start with one that isn't built.
BOOKING_PROVIDER=internal    # google_calendar | calendly | generic_api | internal
CALENDAR_ID=example@group.calendar.google.com
BOOKING_API_BASE_URL=
BOOKING_SYNC_MINUTES=5

# Staff WhatsApp numbers that get the staff_handoff_alert template (comma-separated).
HANDOFF_CONTACTS=+966500000000,+966500000001
# Optional email alerts (comma-separated); needs SMTP_* below.
ALERT_EMAILS=
# e.g. https://agent.example.com, for the inbox link in alert emails.
PUBLIC_BASE_URL=
# "<Arabic> || <English>"; one text without "||" is used for both languages.
HANDOFF_HOURS_MESSAGE="فريقنا يرد من الأحد إلى الخميس، 9 صباحًا إلى 9 مساءً. || Our team replies Sunday to Thursday, 9am to 9pm."
HANDOFF_AUTO_RELEASE_HOURS=24

REMINDER_OFFSETS=24h,2h
FOLLOWUP_DELAY_HOURS=20
FOLLOWUP_COOLDOWN_DAYS=14

# Names exactly as approved in WhatsApp Manager (templates/whatsapp/*.json).
TEMPLATE_REMINDER=appointment_reminder
TEMPLATE_BOOKING_UPDATE=booking_confirmation_update
TEMPLATE_STAFF_ALERT=staff_handoff_alert
TEMPLATE_REOPEN=conversation_reopen
TEMPLATE_FOLLOWUP=lead_followup

LOG_RETENTION_DAYS=90

# Scale-to-zero worker only (demo / low traffic): URL the API pings after queueing a message.
# Leave empty when the worker is always on.
WORKER_WAKE_URL=

LLM_PROVIDER=anthropic       # anthropic (built) | openai | google
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_HISTORY_MESSAGES=20
LLM_MAX_OUTPUT_TOKENS=400

SMTP_HOST=
SMTP_PORT=587
# SMTP_FROM is also the SMTP login user name.
SMTP_FROM=

# ---------- Secrets (secret store only) ----------
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WEBHOOK_VERIFY_TOKEN=replace-me
LLM_API_KEY=replace-me
EMBEDDINGS_API_KEY=
CALENDAR_CREDENTIALS=replace-me
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
INBOX_AUTH_SECRET=replace-me
SMTP_PASSWORD=
