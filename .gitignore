# Per-deployment Cloud Run settings (copy of deploy/gcp/env.example.yaml)
deploy/gcp/env.yaml

# ...except the committed reference run on the demo clinic (portfolio evidence)
!evals/results/
evals/results/*
!evals/results/baseline/
